[Unit]
Description=daesoopbot (bamboozleify-bot) Discord bot
After=network-online.target
Wants=network-online.target

[Service]
User=daesoop
Group=daesoop
WorkingDirectory=/opt/daesoop/bamboozleify-bot
EnvironmentFile=/opt/daesoop/bamboozleify-bot/.env
ExecStart=/opt/daesoop/bamboozleify-bot/.venv/bin/python -m bamboozleify_bot
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
